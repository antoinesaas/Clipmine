# ============================================
#  ClipMine — variables d'environnement
#  Copie en .env.local (dev) + Vercel (prod)
# ============================================

# --- App ---
NEXT_PUBLIC_APP_URL=https://clipmine.fr

# --- Auth (Clerk) — clerk.com ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SECRET=whsec_xxx

# --- Stripe — dashboard.stripe.com ---
STRIPE_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_CREATOR=price_xxx      # Creator 9€/mois
STRIPE_PRICE_PRO=price_xxx          # Pro 24€/mois
STRIPE_PRICE_CREDITS_10=price_xxx   # 10 exports 1,99€

# --- Database (Supabase Postgres) ---
# Comptes utilisateurs, quotas, historique exports
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres

# --- YouTube Data API v3 ---
# console.cloud.google.com → activer YouTube Data API v3
YOUTUBE_API_KEY=AIzaSyxxx

# --- Cloudflare R2 ---
# Stockage des fichiers exportés (MP4)
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=clipmine-exports
# R2_PUBLIC_URL=https://exports.clipmine.fr  # optionnel CDN custom

# --- Worker vidéo (Railway / Fly.io) ---
# ffmpeg + yt-dlp — NE PAS mettre sur Vercel
WORKER_URL=https://clipmine-worker.fly.dev
WORKER_SECRET=genere_une_longue_chaine_aleatoire

# --- Cron Vercel ---
CRON_SECRET=genere_une_longue_chaine_aleatoire

# --- Optionnel ---
OPENAI_API_KEY=sk-xxx

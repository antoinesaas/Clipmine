# ============================================
#  ClipMine — variables d'environnement
#  Copie ce fichier en .env.local et remplis
# ============================================

# --- App ---
NEXT_PUBLIC_APP_URL=https://clipmine.io   # ton domaine déjà acheté

# --- Auth (Clerk) ---
# Crée un compte sur clerk.com -> nouvelle application
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Stripe ---
# dashboard.stripe.com -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# IDs de prix créés dans Stripe (Products)
STRIPE_PRICE_CREATOR=price_xxx     # 9€/mois
STRIPE_PRICE_PRO=price_xxx         # 24€/mois
STRIPE_PRICE_CREDITS_10=price_xxx  # 1,99€ pour 10 exports (one-time)

# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql://user:pass@host:5432/clipmine

# --- YouTube Data API v3 ---
# console.cloud.google.com -> APIs -> YouTube Data API v3
YOUTUBE_API_KEY=xxx

# --- OpenAI (Whisper pour les sous-titres) ---
OPENAI_API_KEY=sk-xxx

# --- Stockage (Cloudflare R2) ---
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=clipmine-exports

# --- Clerk webhook (sync user) ---
CLERK_WEBHOOK_SECRET=whsec_xxx

# --- Cron (Vercel) ---
CRON_SECRET=genere_une_longue_chaine_aleatoire

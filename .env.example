# ============================================
#  ClipMine — variables d'environnement
#  Copie en .env.local (dev) + Vercel (prod)
# ============================================

# --- App ---
NEXT_PUBLIC_APP_URL=https://www.clipmine.fr

# --- Auth (Clerk) — clerk.com ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_CLERK_PROXY_URL=https://www.clipmine.fr/api/clerk-fapi
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SECRET=whsec_xxx

# --- Stripe — dashboard.stripe.com ---
STRIPE_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_CREATOR=price_xxx      # Creator 5,49€/mois (promo -40%, était 9€)
STRIPE_PRICE_PRO=price_xxx          # Pro 14,99€/mois (promo -40%, était 24€)
STRIPE_PRICE_CREDITS_10=price_xxx   # 10 exports 1,19€ (promo -40%, était 1,99€)

# --- Database (Supabase Postgres) ---
# Pooler (Vercel) + direct (migrations Prisma)
# Projet ClipMine : elwqdulkxprjmkejwcai (région eu-west-1)
# Dashboard → bouton vert "Connect" (pas "Connection pooling")
# 1) Transaction pooler → DATABASE_URL (Vercel serverless)
# 2) Direct connection → DIRECT_URL (migrations Prisma)
DATABASE_URL=postgresql://postgres.elwqdulkxprjmkejwcai:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:PASSWORD@db.elwqdulkxprjmkejwcai.supabase.co:5432/postgres

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=AIzaSyxxx

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=clipmine-exports

# --- Worker vidéo (Fly.io) ---
WORKER_URL=https://clipmine-worker.fly.dev
WORKER_SECRET=genere_une_longue_chaine_aleatoire

# --- Cron Vercel ---
CRON_SECRET=genere_une_longue_chaine_aleatoire
